# Public URL of the product app. Every "Find a barber" / "Sign in" call to action
# on the marketing site points here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical URL of this marketing site (metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---- Supabase (optional but recommended) ----
# Read-only, public data: the site shows real shops and real platform numbers.
# Only the anon key is used, and only for data Row Level Security already makes
# public (approved shops). If these are unset the site still builds and renders
# with fallback copy, so a database outage can never take the marketing site down.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
