# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output (any workspace package)
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# testing
coverage/
test-results/
playwright-report/
**/tests/e2e/.auth/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# stray local screenshots
*.png
!public/**/*.png

# cloudflare
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# generated by `pnpm --filter @queuecut/app cf-typegen`
app/cloudflare-env.d.ts
