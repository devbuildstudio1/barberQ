# ---- Supabase (required) ----
# Project URL and anon (public) key. Safe to expose to the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses Row Level Security, so treat it as a root password:
# never expose it to the client and never commit it.
# The application never uses this key at runtime; it is only for local tooling
# (integration/E2E test fixtures and maintenance scripts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
# Public URL of the deployed app (used in metadata/Open Graph and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Maps (optional) ----
# Google Maps JavaScript API key (browser-restricted). If empty, a placeholder map UI is shown.
NEXT_PUBLIC_MAPS_API_KEY=

# ---- Local development (supabase start) ----
# Run `pnpm supabase start` and copy the printed values here.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key>
# SUPABASE_SERVICE_ROLE_KEY=<local service role key>
