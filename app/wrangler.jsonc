{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barberq-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Lets the Worker call itself, which OpenNext needs for cache revalidation.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "barberq-app"
    }
  ],
  // next/image optimisation. There is no sharp on Workers, so this binding
  // (Cloudflare Images) does the resizing instead.
  "images": {
    "binding": "IMAGES"
  }
}
