{
  "name": "queuecut",
  "version": "0.1.0",
  "private": true,
  "description": "Barber queue management platform: product app and marketing website.",
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "dev": "pnpm --filter @queuecut/app dev",
    "dev:website": "pnpm --filter @queuecut/website dev",
    "build": "pnpm -r build",
    "build:app": "pnpm --filter @queuecut/app build",
    "build:website": "pnpm --filter @queuecut/website build",
    "start": "pnpm --filter @queuecut/app start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @queuecut/app test",
    "test:integration": "pnpm --filter @queuecut/app test:integration",
    "test:e2e": "pnpm --filter @queuecut/app test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:start": "pnpm --filter @queuecut/app db:start",
    "db:stop": "pnpm --filter @queuecut/app db:stop",
    "db:reset": "pnpm --filter @queuecut/app db:reset",
    "db:types": "pnpm --filter @queuecut/app db:types",
    "deploy:app": "pnpm --filter @queuecut/app deploy",
    "deploy:website": "pnpm --filter @queuecut/website deploy"
  }
}
